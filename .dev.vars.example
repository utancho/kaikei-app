# ローカル開発用のシークレット。`.dev.vars` にコピーして使ってください(gitignore済み)。
# 本番ではこのファイルではなく `wrangler secret put <NAME>` で設定します。
# ここに書いたキーは wrangler.toml の [vars] と同名でも local dev では優先されます。

JWT_SECRET="change-me-to-a-random-secret"
ENVIRONMENT="development"
APP_URL="http://localhost:5173"

# Stripe(課金機能を使う場合のみ)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRICE_ID="price_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# メール送信(パスワード再設定の自己復旧・請求書メール送信を使う場合のみ)
# Resend(https://resend.com)のAPIキーと送信元アドレスを設定します。
# 未設定の場合、メール機能は「準備中」として無効化され、他機能は通常どおり動作します。
# RESEND_API_KEY="re_..."
# MAIL_FROM="Kaikei <noreply@yourdomain.com>"
