# ローカル開発用の値。本番(Railway等)では別途、環境変数として設定してください。

# SQLiteファイルのパス。本番でボリュームを使う場合は "file:/data/prod.db" のように
# マウントしたボリューム配下の絶対パスを指定してください。
DATABASE_URL="file:./dev.db"

PORT=4000

# フロントエンドの公開URL(Stripe決済完了後のリダイレクト先などに使用)
APP_URL="http://localhost:5173"

# セッション用の署名鍵。本番では必ず十分に長いランダム文字列に変更してください。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-random-secret"

# Stripe(課金機能を使う場合に設定。未設定でもアプリ自体は起動します)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRICE_ID="price_..."       # 月額プランのPrice ID
# STRIPE_WEBHOOK_SECRET="whsec_..." # Webhookエンドポイントの署名シークレット
